# Pengaman bila seluruh folder program terlanjur diekstrak ke public_html:
# arahkan semua permintaan ke folder public, dan tolak akses ke file lain (.env, storage, vendor).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|\.git|storage|vendor|database|config|app|bootstrap|routes|tests)(/|$) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<Files ".env">
    Require all denied
</Files>
