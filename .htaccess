# Pengaman bila seluruh folder program diekstrak langsung ke public_html:
# semua permintaan diteruskan ke folder public, sehingga .env, storage, dan vendor tidak pernah tersaji.
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.(env|git) - [F,L]
    RewriteRule ^(.+)/$ /$1 [R=301,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
