APP_NAME="AKSI Komisaris"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aksi.domainanda.co.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL dari cPanel (format nama biasanya: userCpanel_namadb)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_aksi
DB_USERNAME=cpaneluser_aksi
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email cPanel (opsional, untuk notifikasi email dan reset kata sandi)
MAIL_MAILER=smtp
MAIL_HOST=mail.domainanda.co.id
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@domainanda.co.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@domainanda.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---- AKSI Komisaris ----
# MFA (aplikasi autentikator) wajib. Untuk demo/promosi boleh false.
AKSI_MFA_REQUIRED=true
AKSI_NOTIFY_MAIL=false
AKSI_DISK=local
AKSI_MAX_UPLOAD_KB=51200

# Admin platform dibuat saat "php artisan migrate --seed" bila diisi.
AKSI_ADMIN_EMAIL=
AKSI_ADMIN_PASSWORD=

# Data demo BUMN fiktif (2 perusahaan, 7 akun). Matikan untuk produksi.
AKSI_DEMO=false
AKSI_DEMO_PASSWORD="Demo#2026aksi"

# Ekstraksi teks (opsional; biasanya tidak tersedia di shared hosting)
AKSI_PDFTOTEXT_PATH=/usr/bin/pdftotext
AKSI_TESSERACT_PATH=tesseract

# ---- OpenAI (opsional; tanpa kunci, fitur AI nonaktif dan fitur lain tetap jalan) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=120
# true = jalankan permintaan AI langsung tanpa menunggu cron (lebih lambat di layar)
AKSI_AI_RUN_SYNC=false
